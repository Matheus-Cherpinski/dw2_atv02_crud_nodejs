<%- include('../partials/header', { titulo }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow">K-WAVE / GERENCIAMENTO</p>
    <h1><%= titulo %></h1>
    <p>Consulte os registros cadastrados ou use as ações para criar, editar e excluir.</p>
  </div>
  <a class="button primary" href="<%= novoUrl %>"><span aria-hidden="true">＋</span> Novo cadastro</a>
</section>
<% if (mensagem) { %><div class="notice success"><%= mensagem %></div><% } %>
<% if (erro) { %><div class="notice error"><%= erro %></div><% } %>
<% if (!itens.length) { %>
  <section class="empty-state"><span class="empty-symbol">✧</span><h2>Nenhum registro encontrado</h2><p>Comece criando o primeiro cadastro desta área.</p><a class="button primary" href="<%= novoUrl %>">Cadastrar agora</a></section>
<% } else { %>
  <div class="result-line"><span><strong><%= itens.length %></strong> registro(s)</span><span>CATÁLOGO K-WAVE</span></div>
  <section class="entity-grid">
    <% itens.forEach(item => { %>
      <article class="entity-card">
        <% if (item.imagem) { %><img class="entity-image" src="<%= item.imagem %>" alt="Imagem de <%= item.titulo %>" onerror="this.style.display='none'"><% } else { %><div class="entity-image image-placeholder"><span>KW</span></div><% } %>
        <div class="entity-content">
          <div class="entity-title-row"><span class="entity-id">#<%= String(item.id).padStart(3, '0') %></span><span class="status-dot">●</span></div>
          <h2><%= item.titulo %></h2>
          <p class="entity-subtitle"><%= item.subtitulo %></p>
          <ul class="detail-list"><% item.detalhes.forEach(detalhe => { %><li><%= detalhe %></li><% }) %></ul>
          <div class="card-actions">
            <a class="button small secondary" href="<%= baseUrl %>/<%= item.id %>/editar">Editar</a>
            <form action="<%= baseUrl %>/<%= item.id %>/excluir" method="post" onsubmit="return confirm('Deseja realmente excluir este registro?');">
              <button class="button small danger" type="submit">Excluir</button>
            </form>
          </div>
        </div>
      </article>
    <% }) %>
  </section>
<% } %>
<%- include('../partials/footer') %>
